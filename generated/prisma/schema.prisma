// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum CodeType {
  LOGIN
  RESET_PASSWORD
  INVITATION
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model User {
  id Int @id @default(autoincrement())

  email           String    @unique
  password        String?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  role        Role
  status      UserStatus @default(PENDING)
  phoneNumber String
  birthdate   DateTime

  branchId Int?
  branch   Branch? @relation(fields: [branchId], references: [id])

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  jobPosition String?

  country String?
  city    String?

  firstName String?
  lastName  String?
  avatarUrl String?

  gender String?

  startDate DateTime?
  endDate   DateTime?

  // Security
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // System
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  activityLogs ActivityLog[]

  // 🔹 інвайти, які цей юзер створив (admin)
  createdInvitations Invitation[] @relation("InvitationCreatedBy")

  // 🔹 інвайт, який відноситься до цього юзера
  invitations        Invitation[]        @relation("InvitationForUser")
  emailVerifications EmailVerification[]
}

model Branch {
  id     Int          @id @default(autoincrement())
  name   String       @unique
  status BranchStatus @default(INACTIVE)

  activatedAt   DateTime?
  deactivatedAt DateTime?
  archivedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@index([status])
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model ActivityLog {
  id Int @id @default(autoincrement())

  users User[]
}

enum InvitationStatus {
  PENDING
  USED
  REVOKED
  EXPIRED
}

model Invitation {
  id     String           @id @default(uuid())
  email  String
  token  String           @unique
  status InvitationStatus @default(PENDING)
  role   Role

  createdById Int
  createdBy   User @relation("InvitationCreatedBy", fields: [createdById], references: [id])

  userId Int
  user   User @relation("InvitationForUser", fields: [userId], references: [id])

  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([status])
}

model EmailVerification {
  id           String    @id @default(uuid())
  type         CodeType
  userId       Int
  codeHash     String
  expiresAt    DateTime
  attemptsLeft Int
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}
